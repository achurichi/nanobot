<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nanobot">

  <!-- LIDAR specs -->
  <xacro:property name="lidar_base_x_dim" value="0.0556" />
  <xacro:property name="lidar_base_y_dim" value="0.0556" />
  <xacro:property name="lidar_base_z_dim" value="0.0231" />
  <xacro:property name="lidar_x_offset" value="0.0355" />
  
  <xacro:property name="lidar_link_height" value="0.0182" />
  <xacro:property name="lidar_link_radius" value="0.0255" />
  <xacro:property name="lidar_laser_height" value="0.0067" />
  
  <xacro:property name="lidar_mass" value="0.11" />

  <!-- Links and joints definition -->

  <!-- Base -->

  <joint name="lidar_base_joint" type="fixed">
    <parent link="body_link" />
    <child link="lidar_base_link" />
    <origin xyz="${-body_x_dim/2 + lidar_x_offset} 0 ${body_z_dim}" rpy="0 0 ${-pi/2}" />
  </joint>

  <link name="lidar_base_link">
    <visual>
      <origin xyz="0 0 ${lidar_base_z_dim/2}" rpy="0 0 0" />
      <geometry>
        <box size="${lidar_base_x_dim} ${lidar_base_y_dim} ${lidar_base_z_dim}" />
      </geometry>
      <material name="red" />
    </visual>
    <collision>
      <origin xyz="0 0 ${lidar_base_z_dim/2}" rpy="0 0 0" />
      <geometry>
        <box size="${lidar_base_x_dim} ${lidar_base_y_dim} ${lidar_base_z_dim}" />
      </geometry>
    </collision>
    <xacro:inertial_box mass="${lidar_mass/2}" x="${lidar_base_x_dim}" y="${lidar_base_y_dim}"
      z="${lidar_base_z_dim}">
      <origin xyz="0 0 ${lidar_base_z_dim/2}" rpy="0 0 0" />
    </xacro:inertial_box>
  </link>

  <!-- Link -->

  <joint name="lidar_link_joint" type="fixed">
    <parent link="lidar_base_link" />
    <child link="lidar_link" />
    <origin xyz="0 0 ${lidar_base_z_dim + lidar_laser_height}" rpy="0 0 0" />
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 ${lidar_link_height/2 - lidar_laser_height}" rpy="0 0 0" />
      <geometry>
        <cylinder length="${lidar_link_height}" radius="${lidar_link_radius}" />
      </geometry>
      <material name="red" />
    </visual>
    <collision>
      <origin xyz="0 0 ${lidar_link_height/2 - lidar_laser_height}" rpy="0 0 0" />
      <geometry>
        <cylinder length="${lidar_link_height}" radius="${lidar_link_radius}" />
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="${lidar_mass/2}" length="${lidar_link_height}" radius="${lidar_link_radius}">
      <origin xyz="0 0 ${lidar_link_height/2 - lidar_laser_height}" rpy="0 0 0" />
    </xacro:inertial_cylinder>
  </link>

  <!-- Gazebo -->

  <gazebo reference="lidar_base_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/Red</material>

    <sensor name="laser" type="gpu_lidar">
      <pose> 0 0 0 0 0 0 </pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>12</max>
        </range>
      </lidar>
      <topic>lidar/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
    </sensor>
  </gazebo>
  
</robot>